{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "nasu/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "meo-diagnosis/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "google-maps-check/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "geo-meo/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "restaurant-meo/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "tourism-meo/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "google-business-profile-check/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "why-free/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy/**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/analyze-place",
      "dest": "/api/analyze-place.js"
    },
    {
      "src": "/api/place-search",
      "dest": "/api/place-search.js"
    },
    {
      "src": "/styles.css",
      "dest": "/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/meo-diagnosis/?",
      "dest": "/meo-diagnosis/index.html"
    },
    {
      "src": "/google-maps-check/?",
      "dest": "/google-maps-check/index.html"
    },
    {
      "src": "/geo-meo/?",
      "dest": "/geo-meo/index.html"
    },
    {
      "src": "/restaurant-meo/?",
      "dest": "/restaurant-meo/index.html"
    },
    {
      "src": "/tourism-meo/?",
      "dest": "/tourism-meo/index.html"
    },
    {
      "src": "/google-business-profile-check/?",
      "dest": "/google-business-profile-check/index.html"
    },
    {
      "src": "/why-free/?",
      "dest": "/why-free/index.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/nasu/?",
      "dest": "/nasu/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
